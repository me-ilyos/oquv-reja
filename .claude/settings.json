{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(.env)",
      "Edit(./.env)",
      "Edit(.env)",
      "Write(./.env)",
      "Write(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_access.js\""
          }
        ]
      }
    ]
  }
}
